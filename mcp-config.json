{
  "mcpServers": {
    "rea": {
      "command": "rea",
      "args": ["--mcp"],
      "env": {
        "PATH": "%PATH%"
      }
    },
    "netvein": {
      "command": "netvein",
      "args": ["serve", "--mcp"]
    },
    "lemma": {
      "command": "npx",
      "args": ["-y", "lemma"]
    }
  }
}